-- Muudame päästikut, et jälgida ka tabeli muutmist ja kustutamist
ALTER TRIGGER trDavidMyrsethTrigger
ON Database
FOR CREATE_TABLE, ALTER_TABLE, DROP_TABLE
AS
BEGIN
Print 'Teie tabel on loodud, saate seda muuta või kustutada' -- Kuvame teate, et tabel on loodud ja seda saab muuta või kustutada
END

-- Muudame päästiku, et blokeerida tabelite loomine, muutmine ja kustutamine
ALTER TRIGGER trDavidMyrsethTrigger
ON Database
FOR CREATE_TABLE, ALTER_TABLE, DROP_TABLE
AS
BEGIN
ROLLBACK -- Tühistame kõik muudatused
PRINT 'Te ei saa tabelit luua, muuta ega kustutada' -- Kuvame teate, et pole lubatud tabelit luua, muuta ega kustutada
END

